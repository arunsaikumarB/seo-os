# Company / DD3-style — place these at the ba-frontend REPO ROOT:
#   cp .env.company.frontend.example .env
#   cp .env.company.frontend.example .env.production
#
# Same layout as DD3 website: secrets live next to package.json, not under apps/web/.
# Then from repo root: npm install && npm run build  -> apps/web/dist

VITE_AUTH_MODE=local
VITE_API_URL=https://YOUR-API-HOST

# Internal QA only (same machine as API):
# VITE_API_URL=http://localhost:3001
