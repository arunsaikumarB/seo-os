# =============================================================================
# SEO OS — Root environment template
# Copy to apps/api/.env and apps/web/.env (see README)
# =============================================================================

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# CORS
CORS_ORIGIN=http://localhost:5173

# Encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=
# Optional error tracking (install @sentry/node in apps/api to activate)
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# AI. Ollama is used only when OLLAMA_ENABLED=true and OLLAMA_BASE_URL is set.
# OLLAMA_MODEL defaults to llama3.2. Example for a local pull: qwen2.5:7b
GEMINI_API_KEY=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Leave GENERATION_MOCK unset. It does not create backlink or outreach copy.

# SMTP fallback when no outreach email account row exists (Gmail app password: port 465).
# A saved account stores the password with ENCRYPTION_KEY. Never commit SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Provider mode: mvp | free | paid
PROVIDER_MODE=mvp

# Jobs (unset + NODE_ENV=production defaults to true; set false for local API-only)
ENABLE_WORKERS=false

# --- Web (apps/web/.env) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:3001
