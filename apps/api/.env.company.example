# Company / DD3-style stack — DevOps: after pull on ba-backend:
#   cp apps/api/.env.company.example apps/api/.env
# Edit the REPLACE_/YOUR_ values below, restore DB dump, then:
#   npm install && npm run build && npm run start
#
# Does NOT use Supabase Cloud or Supabase Auth.

NODE_ENV=production
PORT=3001
COMPANY_STACK=true
# COMPANY_STACK forces AUTH_MODE=local + DATA_MODE=pg

LOCAL_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/backlink_agent
CORS_ORIGIN=https://YOUR-WEB-HOST
PROVIDER_MODE=mvp
ENABLE_WORKERS=true

# Not used when COMPANY_STACK=true — leave unset
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
