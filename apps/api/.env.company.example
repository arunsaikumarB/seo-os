# Company / DD3-style stack — copy to apps/api/.env for internal server demos.
# Does NOT use Supabase Cloud or Supabase Auth.
#
# Prerequisites:
#   docker compose --profile company-postgres up -d company-postgres
#   powershell -File scripts/cutover/dump-local-postgres.ps1
#   powershell -File scripts/cutover/restore-company-postgres.ps1 -DumpPath .cutover-dumps\<file>.dump

NODE_ENV=development
PORT=3001
COMPANY_STACK=true
# COMPANY_STACK forces AUTH_MODE=local + DATA_MODE=pg

LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/backlink_agent
CORS_ORIGIN=http://localhost:5173
PROVIDER_MODE=mvp
ENABLE_WORKERS=true

# Optional placeholders (not used when COMPANY_STACK=true)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
