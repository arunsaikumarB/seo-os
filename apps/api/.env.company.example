# Company / DD3-style stack.
# On GitLab ba-backend: copy ROOT `.env.example` -> ROOT `.env` (DD3 layout).
# Local monorepo fallback: copy this file to apps/api/.env
# Does NOT use Supabase Cloud or Supabase Auth.

NODE_ENV=production
PORT=3001
COMPANY_STACK=true
# COMPANY_STACK forces AUTH_MODE=local + DATA_MODE=pg

LOCAL_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/backlink_agent
# Exact frontend browser URL (no trailing slash). Example: http://10.0.12.193:5000
# Or CORS_ORIGIN=* for internal LAN only.
CORS_ORIGIN=http://10.0.12.193:5000
PROVIDER_MODE=mvp
ENABLE_WORKERS=true

# Not used when COMPANY_STACK=true — leave unset
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
