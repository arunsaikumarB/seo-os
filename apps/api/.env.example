# API environment — copy from root .env.example
NODE_ENV=development
PORT=3001
# Auth cutover (Phase 2). Keep supabase unless you intentionally test local API auth.
AUTH_MODE=supabase
# Data cutover (Phase 4). Keep supabase unless testing core tenancy on plain Postgres.
DATA_MODE=supabase
# LOCAL_JWT_SECRET=at-least-32-characters-long-secret-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
CORS_ORIGIN=http://localhost:5173
PROVIDER_MODE=mvp
ENABLE_WORKERS=false
