# API environment — copy from root .env.example
NODE_ENV=development
PORT=3001
# Default = Supabase demo stack. For company Postgres without Supabase, see .env.company.example
# COMPANY_STACK=true
AUTH_MODE=supabase
DATA_MODE=supabase
# LOCAL_JWT_SECRET=at-least-32-characters-long-secret-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
CORS_ORIGIN=http://localhost:5173
PROVIDER_MODE=mvp
ENABLE_WORKERS=false
ENCRYPTION_KEY=
GEMINI_API_KEY=
# Ollama runs only when both are set. Model defaults to llama3.2.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Leave GENERATION_MOCK unset. It does not create backlink or outreach copy.
# SMTP used when no email account row exists.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
