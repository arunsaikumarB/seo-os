# Copy to apps/web/.env.production before `npm run build` on company host.
# Vite production mode reads this file (not only .env).
#
#   cp apps/web/.env.company.example apps/web/.env
#   cp apps/web/.env.production.example apps/web/.env.production
#   # edit VITE_API_URL, then from repo ROOT:
#   npm run build

VITE_AUTH_MODE=local
VITE_API_URL=https://YOUR-API-HOST

# Optional: allow localhost API in a production build (internal QA only)
# VITE_ALLOW_LOCALHOST_API=true
# VITE_API_URL=http://localhost:3001
