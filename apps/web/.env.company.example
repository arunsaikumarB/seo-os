# Company / DD3-style web — copy to BOTH of these on the company server:
#   cp apps/web/.env.company.example apps/web/.env
#   cp apps/web/.env.company.example apps/web/.env.production
#
# `npm run build` uses production mode and reads .env.production.
# Pair with apps/api/.env.company.example (COMPANY_STACK=true).

VITE_AUTH_MODE=local
# Public API URL as browsers will call it (NOT Supabase, NOT Railway unless that is your API)
VITE_API_URL=https://YOUR-API-HOST.example.com

# Optional: allow building with http://localhost:3001 for same-machine smoke only
# VITE_ALLOW_LOCALHOST_API=true

# Not required in local auth mode (realtime disabled)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
