# Company / DD3-style web — copy to BOTH:
#   apps/web/.env
#   apps/web/.env.production   (needed for `npm run build` — Vite production mode)
#
# Pair with apps/api/.env.company.example (COMPANY_STACK=true).
#
# Build from the ba-frontend REPO ROOT (not apps/web):
#   npm install
#   npm run build
# Output: apps/web/dist

VITE_AUTH_MODE=local
# Use your real company API URL in production. Localhost is OK for internal QA
# when VITE_AUTH_MODE=local (guard allows it).
VITE_API_URL=http://localhost:3001

# Not required in local auth mode (realtime disabled)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
