# Company stack — DevOps: copy BOTH after pull:
#   cp apps/web/.env.company.example apps/web/.env
#   cp apps/web/.env.company.example apps/web/.env.production
# Then replace YOUR-API-HOST with the real public API URL and rebuild:
#   npm run build

VITE_AUTH_MODE=local
VITE_API_URL=https://YOUR-API-HOST

# Same-machine smoke only (optional):
# VITE_API_URL=http://localhost:3001
# VITE_ALLOW_LOCALHOST_API=true
