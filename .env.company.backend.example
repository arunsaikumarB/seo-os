# Company / DD3-style — place this file at the ba-backend REPO ROOT as `.env`
#   cp .env.example .env
#
# Same layout as DD3 website: secrets live next to package.json, not under apps/.
# Does NOT use Supabase Cloud or Supabase Auth.

NODE_ENV=production
PORT=3001
COMPANY_STACK=true
# COMPANY_STACK forces AUTH_MODE=local + DATA_MODE=pg

LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/backlink_agent

# Empty DB? From repo root (after npm install):
#   npm run db:setup
# Uses apps/api/src/db/Database.ts (no pgvector). Also auto-runs when COMPANY_STACK=true.

# Must match the browser URL of the frontend exactly (scheme + host + port, no trailing slash).
# Example: CORS_ORIGIN=http://10.0.12.193:5000
# Or allow any Origin on internal LAN only: CORS_ORIGIN=*
CORS_ORIGIN=http://10.0.12.193:5000

PROVIDER_MODE=mvp
ENABLE_WORKERS=true
# Faster Import on company hosts (outbound HTTPS often slow/blocked)
ANALYZE_SKIP_LIVE=true
IMPORT_VALIDATE_CONCURRENCY=6
ANALYZE_HOME_TIMEOUT_MS=4000
ANALYZE_AUX_TIMEOUT_MS=2000
PG_POOL_MAX=25
