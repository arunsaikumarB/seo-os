# Company / DD3-style — place this file at the ba-backend REPO ROOT as `.env`
#   cp .env.company.backend.example .env
#
# Same layout as DD3 website: secrets live next to package.json, not under apps/.
# Does NOT use Supabase Cloud or Supabase Auth.

NODE_ENV=production
PORT=3001
COMPANY_STACK=true
# COMPANY_STACK forces AUTH_MODE=local + DATA_MODE=pg

LOCAL_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/backlink_agent
CORS_ORIGIN=https://YOUR-WEB-HOST
PROVIDER_MODE=mvp
ENABLE_WORKERS=true
